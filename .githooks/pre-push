#!/usr/bin/env bash
# Run the e2e gate before a push whose changes it covers can reach CI/prod.
# Installed automatically by scripts/dev.sh (it sets core.hooksPath=.githooks).
# Bypass with `git push --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

z=0000000000000000000000000000000000000000

# Only run when the push touches what the suite builds and exercises — the worker
# and the static-site sources (src/) the dom tests drive — not docs or tooling.
# git feeds pre-push one "<localref> <localsha> <remoteref> <remotesha>" line
# per ref on stdin.
touched=false
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$z" ] && continue                                   # ref deletion
  if [ "$rsha" = "$z" ]; then                                      # new remote branch
    base="$(git rev-parse --verify --quiet origin/main || true)"
    [ -z "$base" ] && { touched=true; break; }
    range="$base..$lsha"
  else
    range="$rsha..$lsha"
  fi
  files="$(git diff --name-only "$range" -- worker/ src/ 2>/dev/null || echo FORCE)"
  [ -n "$files" ] && { touched=true; break; }
done
$touched || exit 0

echo "pre-push: running the e2e gate (skip with --no-verify)…"
# Isolated: temp state dir + random port, so it can't clash with a running dev.sh.
bash scripts/e2e.sh --snapshot
